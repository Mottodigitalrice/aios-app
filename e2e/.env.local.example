# Copy to e2e/.env.local (gitignored). Required for the cleanup hook to archive
# [VISIT] tasks that the spec creates in the "AIOS Referral Events" Notion project.
# Get a fresh token from: curl -s -X POST https://vps.mottodigital.jp/auth/session \
#   -H "Content-Type: application/json" \
#   -d "{\"password\": \"$(cat ~/.motto-proxy-password)\"}"
MOTTO_SESSION_TOKEN=

# AIOS Referral Events Notion project (target for [VISIT] task cleanup)
REFERRAL_EVENTS_PROJECT_ID=35ee0cb5-63d9-8170-9345-ec835c07acd6

# AIOS main project (target for the T7 real-submission cleanup, when un-skipped)
AIOS_PROJECT_ID=1ede0cb5-63d9-8061-8571-df183897d8e2

# MOTTO API base
MOTTO_API_BASE=https://vps.mottodigital.jp
