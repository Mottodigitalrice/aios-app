# Convex
# (These are auto-populated when you run `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk
# Get from: https://dashboard.clerk.com
# NOTE: Clerk auth is currently disabled (see src/middleware.ts). These keys
# only need values if you re-enable auth on the (dashboard)/(auth) routes.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# OpenRouter
# Get from: https://openrouter.ai/keys
# WARNING: /api/ai is currently unauthenticated — do not commit a key with a
# high spend limit until rate-limiting and auth are added (tracked separately).
OPENROUTER_API_KEY=

# Report Generation API
# Used to protect the /api/generate-report endpoint (for n8n webhooks).
# Header format: Authorization: Bearer <REPORT_API_KEY>
REPORT_API_KEY=

# MOTTO API (Notion proxy + Tasks)
# Used by all submission routes (audit, signup, webinar, audit-legacy,
# track-visit). Token format: X-API-Key: <MOTTO_API_KEY>.
MOTTO_API_KEY=

# Notion database ids — used to dual-write structured rows alongside the
# Tasks-DB inbox entry. If unset, the helper short-circuits cleanly and
# submissions still flow (inbox-only).
AIOS_SIGNUPS_DATABASE_ID=
AUDIT_SUBMISSIONS_DB_ID=

# Optional: deploy under a sub-path (e.g. for VPS preview at /v1). Leave empty
# for production aios.mottodigital.jp. NEXT_OUTPUT=standalone enables the
# self-contained build target for Docker / VPS deploys.
NEXT_BASE_PATH=
NEXT_OUTPUT=

# ngrok (for sharing demos)
# Get domain from: https://dashboard.ngrok.com/domains
NGROK_DOMAIN=
