{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "build": {
    "env": {
      "NEXT_DISABLE_TURBOPACK": "1"
    }
  },
  "redirects": [
    {
      "source": "/audit",
      "destination": "https://mottodigital.jp/audit",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://mottodigital.jp/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://mottodigital.jp/",
      "permanent": true
    }
  ]
}
